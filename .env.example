# SecondSelf Environment Configuration
# Copy this file to '.env' and fill in your actual API keys.

# Groq API Key for Llama-3 classification and RAG synthesis
# Get a free key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Hugging Face User Access Token (to disable unauthenticated download warnings)
# Get a free read token from: https://huggingface.co/settings/tokens
# HF_TOKEN=your_huggingface_token_here

